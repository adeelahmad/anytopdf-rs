{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adeelahmad/anytopdf-rs/schemas/capabilities/v1",
  "title": "anytopdf capabilities",
  "type": "object",
  "required": ["schema_version", "exit_codes", "diagnostic_codes", "profiles", "ocr_modes", "importers", "schemas"],
  "properties": {
    "schema_version": {"const": "anytopdf.capabilities/1"},
    "exit_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name"],
        "properties": {
          "code": {"type": "integer", "minimum": 0},
          "name": {"type": "string"}
        }
      }
    },
    "diagnostic_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["info", "warning"]}
        }
      }
    },
    "profiles": {"type": "array", "items": {"type": "string"}},
    "ocr_modes": {"type": "array", "items": {"type": "string"}},
    "importers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {"name": {"type": "string"}}
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {"id": {"type": "string"}}
      }
    }
  }
}
