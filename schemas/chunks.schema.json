{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adeelahmad/anytopdf-rs/schemas/chunks/v1",
  "title": "anytopdf chunks",
  "type": "object",
  "required": ["schema_version", "chunks"],
  "properties": {
    "schema_version": {"const": "anytopdf.chunks/1"},
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_id", "kind", "text", "anchor", "pages", "providers"],
        "properties": {
          "id": {"type": "string"},
          "source_id": {"type": "string"},
          "kind": {"type": "string", "enum": ["visual", "text", "audio", "existing-pdf", "generic"]},
          "text": {"type": "string"},
          "anchor": {
            "type": "object",
            "required": ["kind"],
            "properties": {"kind": {"type": "string", "enum": ["time-span", "region", "byte-range"]}}
          },
          "pages": {
            "type": "object",
            "required": ["first", "last"],
            "properties": {"first": {"type": "integer", "minimum": 1}, "last": {"type": "integer", "minimum": 1}}
          },
          "providers": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
